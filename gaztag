def has_cover_sidecar(directory: Path) -> bool:
    return any((directory / n).exists() for n in COVER_SIDECAR_NAMES)


def _save_image(data: bytes, dest: Path, max_px: int) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    if Image is not None:
        from io import BytesIO
        img = Image.open(BytesIO(data)).convert("RGB")
        if max(img.size) > max_px:
            scale = max_px / max(img.size)
            img = img.resize((round(img.width * scale), round(img.height * scale)))
        img.save(dest, format="JPEG", quality=92)
    else:
        dest.write_bytes(data)


def fetch_url_bytes(session: requests.Session, url: str, timeout: float) -> Optional[bytes]:
    try:
        resp = session.get(url, timeout=timeout)
        resp.raise_for_status()
        return resp.content
    except requests.RequestException:
        return None


def resolve_cover(cfg: Config, session: requests.Session, meta: AlbumMeta) -> Optional[str]:
    for source in cfg.cover_sources:
        if source == "tracker" and meta.wiki_image:
            return meta.wiki_image
        if source == "itunes":
            url = _itunes_cover(session, meta, cfg)
            if url:
                return url
    return None


def _itunes_cover(session: requests.Session, meta: AlbumMeta, cfg: Config) -> Optional[str]:
    term = f"{meta.album_artist} {meta.album}".strip()
    try:
        resp = session.get(
            "https://itunes.apple.com/search",
            params={"term": term, "entity": "album", "limit": 1},
            timeout=cfg.request_timeout,
        )
        resp.raise_for_status()
        results = resp.json().get("results") or []
    except (requests.RequestException, ValueError):
        return None
    if not results:
        return None
    art = results[0].get("artworkUrl100")
    if not art:
        return None
    return re.sub(r"/\d+x\d+bb\.jpg$", f"/{cfg.max_art_px}x{cfg.max_art_px}bb.jpg", art)


def image_dimensions(path: Path) -> Optional[tuple[int, int]]:
    if Image is None:
        return None
    try:
        with Image.open(path) as img:
            return img.size
    except Exception:
        return None


def image_dimensions_bytes(data: bytes) -> Optional[tuple[int, int]]:
    if Image is None:
        return None
    try:
        from io import BytesIO
        with Image.open(BytesIO(data)) as img:
            return img.size
    except Exception:
        return None


def _cover_qualifies(path: Path, min_px: int) -> bool:
    dims = image_dimensions(path)
    if dims is None:
        # Dimensions are unavailable without Pillow; fall back to name/count.
        return True
    return min(dims) >= min_px


@dataclass
class AuxClassification:
    cover: Optional[Path] = None
    other_images: list[Path] = field(default_factory=list)
    booklets: list[Path] = field(default_factory=list)
    extras: list[Path] = field(default_factory=list)
    ambiguous_cover: bool = False
    # The selected cover falls below cfg.min_cover_px on its shorter side and is
    # therefore provisional: a remote candidate meeting the threshold supersedes
    # it, in which case the local image is diverted to unmatched files.
    cover_below_threshold: bool = False


def classify_aux_files(cfg: Config, source_dir: Path) -> AuxClassification:
    """Sort non-audio payload into cover, other images, booklets, and extras.

    The cover is a qualifying image (at least cfg.min_cover_px on its shorter
    side) that is either named like a cover or is the only qualifying image.
    A single image in the source directory is treated as the cover regardless
    of the pixel gate. When several images qualify and none is named like a
    cover, selection is ambiguous: no cover is chosen and every image is filed
    under the scans subdirectory.
    """
    result = AuxClassification()
    images: list[Path] = []
    for p in sorted(source_dir.rglob("*")):
        if not p.is_file():
            continue
        ext = p.suffix.lower()
        if ext in AUDIO_EXTENSIONS:
            continue
        if ext in IMAGE_EXTENSIONS:
            images.append(p)
        elif ext in BOOKLET_EXTENSIONS:
            result.booklets.append(p)
        else:
            result.extras.append(p)

    eligible = [im for im in images if im.suffix.lower() in COVER_IMAGE_EXTENSIONS]
    qualifying = [im for im in eligible if _cover_qualifies(im, cfg.min_cover_px)]
    # A cover-named image is selected even below the pixel gate; explicit naming
    # is treated as stronger evidence than resolution.
    named = [im for im in eligible if im.stem.lower() in COVER_NAME_STEMS]
    cover: Optional[Path] = None
    if named:
        cover = named[0]
    elif len(qualifying) == 1:
        cover = qualifying[0]
    elif len(qualifying) > 1:
        result.ambiguous_cover = True
    elif len(eligible) == 1:
        # No image meets the pixel gate, but a sole image in the directory is
        # assumed to be album art rather than a scan.
        cover = eligible[0]
    elif len(images) == 1:
        # Sole image of any recognized type, including formats not eligible for
        # in-place cover use; retained as cover for downstream conversion.
        cover = images[0]

    result.cover = cover
    if cover is not None and cover not in qualifying:
        result.cover_below_threshold = True
    result.other_images = [im for im in images if im != cover]
    return result


def cover_destination(cfg: Config, album_dir: Path, cover: Path) -> tuple[Path, bool]:
    """Return the cover destination path and whether a PNG->JPEG conversion runs."""
    convert = (cover.suffix.lower() == ".png" and cfg.cover_convert_png_to_jpg
               and Image is not None)
    if cover.suffix.lower() in (".jpg", ".jpeg") or convert:
        dest_name = cfg.cover_filename  # cover.jpg
    else:
        dest_name = str(Path(cfg.cover_filename).with_suffix(cover.suffix.lower()))
    return album_dir / dest_name, convert


