# ID3 frame classes keyed by logical field. Custom fields use TXXX descriptors.
_ID3_TXXX = {"releasetype", "albumversion", "catalognumber"}
_ID3_FRAMES = {
    "genre": "TCON", "album": "TALB", "albumartist": "TPE2",
    "date": "TDRC", "organization": "TPUB", "discnumber": "TPOS",
    "tracknumber": "TRCK",
}
_MP4_ATOMS = {
    "genre": "\xa9gen", "album": "\xa9alb", "albumartist": "aART", "date": "\xa9day",
}


def _write_vorbis(audio, fields: dict[str, list[str]]) -> None:
    for key, values in fields.items():
        audio[key] = values


def _write_id3(audio, fields: dict[str, list[str]]) -> None:
    id3 = audio.tags
    for key, values in fields.items():
        text = values if isinstance(values, list) else [values]
        if key in _ID3_TXXX:
            id3.delall(f"TXXX:{key.upper()}")
            id3.add(mutagen.id3.TXXX(encoding=3, desc=key.upper(), text=text))
        elif key in _ID3_FRAMES:
            frame_cls = getattr(mutagen.id3, _ID3_FRAMES[key])
            id3.setall(_ID3_FRAMES[key], [frame_cls(encoding=3, text=text)])


def _write_mp4(audio, fields: dict[str, list[str]]) -> None:
    for key, values in fields.items():
        if key in ("discnumber", "tracknumber"):
            atom = "disk" if key == "discnumber" else "trkn"
            first = values[0] if values else "0"
            parts = re.split(r"[/\s]+", first)
            number = int(parts[0] or 0)
            total = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0
            audio[atom] = [(number, total)]
        elif key in _MP4_ATOMS:
            audio[_MP4_ATOMS[key]] = values
        else:
            atom = f"----:com.apple.iTunes:{key.upper()}"
            audio[atom] = [v.encode("utf-8") for v in values]


def apply_tags(path: Path, fields: dict[str, list[str]]) -> None:
    if mutagen is None or not fields:
        return
    try:
        audio = mutagen.File(str(path))
    except Exception:
        return
    if audio is None:
        return
    if audio.tags is None:
        try:
            audio.add_tags()
        except Exception:
            return
    if isinstance(audio.tags, mutagen.id3.ID3):
        _write_id3(audio, fields)
    elif isinstance(audio, mutagen.mp4.MP4):
        _write_mp4(audio, fields)
    else:
        # Vorbis comment (FLAC, Ogg) and APEv2 behave as case-insensitive maps.
        _write_vorbis(audio, fields)
    audio.save()


def fields_for_plan(cfg: Config, plan: "AlbumPlan") -> dict[str, list[str]]:
    fields: dict[str, list[str]] = {}
    if cfg.write_genre and plan.genres:
        fields["genre"] = ([cfg.genre_join.join(plan.genres)]
                           if cfg.genre_join is not None else list(plan.genres))
    if cfg.write_album and plan.album:
        fields["album"] = [plan.album]
    if cfg.write_albumartist and plan.album_artist:
        fields["albumartist"] = [plan.album_artist]
    if cfg.write_date and plan.year:
        fields["date"] = [str(plan.year)]
    if cfg.write_releasetype and plan.release_type_name:
        fields["releasetype"] = [plan.release_type_name]
    if cfg.write_albumversion and plan.albumversion:
        fields["albumversion"] = [plan.albumversion]
    if cfg.write_label and plan.label:
        fields["organization"] = [plan.label]
    if cfg.write_catalognumber and plan.catalog:
        fields["catalognumber"] = [plan.catalog]
    return fields


