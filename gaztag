@dataclass
class FileOp:
    src: str
    dest: str
    disc: int
    track: int


@dataclass
class AuxMove:
    src: str
    dest: str


@dataclass
class AlbumPlan:
    source_dir: str
    matched: bool
    warnings: list[str] = field(default_factory=list)
    album: str = ""
    year: int = 0
    album_artist: str = ""
    genres: list[str] = field(default_factory=list)
    raw_tags: list[str] = field(default_factory=list)
    release_type_name: str = ""
    albumversion: str = ""
    label: str = ""
    catalog: str = ""
    media: str = ""
    sample_rate: str = ""
    is_dsd: bool = False
    album_dir: str = ""
    artist_dir: str = ""
    files: list[FileOp] = field(default_factory=list)
    cover_url: Optional[str] = None
    cover_dest: Optional[str] = None
    # Remote cover bytes fetched at plan time when adjudicating a provisional
    # local cover against a remote candidate; reused during apply to avoid a
    # second download. Not serialized to the plan JSON.
    cover_data: Optional[bytes] = field(default=None, repr=False)
    local_cover_src: Optional[str] = None
    local_cover_convert: bool = False
    artist_image_url: Optional[str] = None
    artist_image_dest: Optional[str] = None
    booklet_files: list[AuxMove] = field(default_factory=list)
    unmatched_images: list[AuxMove] = field(default_factory=list)
    extra_files: list[AuxMove] = field(default_factory=list)


def build_plan_for_dir(cfg: Config, tracker: Tracker, index: TorrentIndex,
                       source_dir: Path) -> AlbumPlan:
    plan = AlbumPlan(source_dir=str(source_dir), matched=False)
    log(f"processing: {source_dir.name}")
    result = index.match(source_dir)
    ref = result.ref
    if ref is None:
        detail = f"; closest torrent: {result.suggestion}" if result.suggestion else ""
        log(f"  no torrent match{detail}")
        plan.warnings.append("no matching torrent found for directory name")
        return plan
    log(f"  matched torrent [{result.method}]: {ref.name}")
    lookup = f"id={ref.torrent_id}" if ref.torrent_id is not None else f"infohash {ref.infohash[:12]}"
    log(f"  querying tracker ({lookup})")
    try:
        response = resolve_album(tracker, ref)
    except (TrackerError, requests.RequestException) as exc:
        log(f"  tracker lookup failed: {exc}")
        plan.warnings.append(f"tracker lookup failed: {exc}")
        return plan

    meta = build_album_meta(cfg, response)
    log(f"  resolved: {meta.album_artist} - {meta.album} ({meta.year})")
    if not meta.genres:
        plan.warnings.append("release carries no usable genre tags")

    tracks = collect_tracks(source_dir)
    if not tracks:
        log("  no audio files found")
        plan.warnings.append("no audio files found in source directory")
        return plan
    multidisc = len({t.disc for t in tracks}) > 1

    is_dsd = any(t.is_dsd for t in tracks)
    rates = [t.sample_rate for t in tracks if t.sample_rate > 0]
    album_rate = max(rates) if rates else 0
    sample_rate = format_sample_rate(album_rate, is_dsd, cfg.dsd_sample_rate_unit)
    if not sample_rate:
        plan.warnings.append("sample rate could not be determined")
    descriptors = [f"{len(tracks)} tracks"]
    if multidisc:
        descriptors.append("multi-disc")
    descriptors.append("DSD" if is_dsd else "PCM")
    descriptors.append(sample_rate or "rate?")
    log("  " + " | ".join(descriptors))
    if meta.genres:
        log(f"  genres: {'; '.join(meta.genres)}")

    albumversion = build_albumversion(cfg, meta, is_dsd)
    if albumversion:
        log(f"  version: {albumversion}")

    # The album title used for tagging has any redundant trailing edition
    # segment removed. The directory name retains the original title, including
    # the edition, so that distinct releases of the same album resolve to
    # separate directories rather than colliding on the filesystem.
    album_title = strip_album_edition(cfg, meta)
    if album_title != meta.album:
        log(f"  album tag: edition stripped ({meta.album!r} -> {album_title!r})")

    dest_root = Path(cfg.dest_root).expanduser() if cfg.dest_root else source_dir.parent
    if is_dsd and cfg.dsd_subdir:
        dest_root = dest_root / cfg.dsd_subdir
    artist_dir = dest_root / sanitize(meta.album_artist)
    album_dir_name = cfg.album_dir_template.format(
        year=meta.year or "0000",
        album=sanitize(meta.album),
        sort_title=sanitize(sort_title(cfg, meta.album)),
        album_artist=sanitize(meta.album_artist),
        label=sanitize(meta.label) if meta.label else "",
        catno=sanitize(meta.catalog) if meta.catalog else "",
        sample_rate=sample_rate,
        release_type=meta.release_type_name,
        version=albumversion,
    )
    album_dir = artist_dir / _clean_dir_name(album_dir_name)

    plan.matched = True
    plan.album = album_title
    plan.year = meta.year
    plan.album_artist = meta.album_artist
    plan.genres = meta.genres
    plan.raw_tags = meta.raw_tags
    plan.release_type_name = meta.release_type_name
    plan.albumversion = albumversion
    plan.label = meta.label
    plan.catalog = meta.catalog
    plan.media = meta.media
    plan.sample_rate = sample_rate
    plan.is_dsd = is_dsd
    plan.album_dir = str(album_dir)
    plan.artist_dir = str(artist_dir)

    seen_dests: set[str] = set()
    for t in sorted(tracks, key=lambda x: (x.disc, x.track, x.src.name)):
        pos = position_string(t.disc, t.track, multidisc)
        new_name = sanitize(cfg.file_template.format(
            pos=pos, title=t.title, disc=t.disc, track=t.track, ext=t.src.suffix.lower()
        ))
        dest = album_dir / new_name
        if str(dest) in seen_dests:
            plan.warnings.append(f"duplicate destination name: {new_name}")
        seen_dests.add(str(dest))
        plan.files.append(FileOp(src=str(t.src), dest=str(dest), disc=t.disc,
                                 track=t.track))

    # Included artwork and other leftover payload.
    aux = classify_aux_files(cfg, source_dir) if cfg.handle_aux_files else AuxClassification()
    scans_root = album_dir / cfg.scans_dirname
    unmatched_root = source_dir.parent / cfg.unmatched_images_dirname / source_dir.name
    extras_root = source_dir.parent / cfg.extra_files_dirname / source_dir.name
    booklet_root = album_dir / cfg.booklet_dirname

    cover_chosen = False
    provisional_local: Optional[Path] = None
    if cfg.use_included_cover and aux.cover is not None:
        if aux.cover_below_threshold:
            # A sub-threshold local cover is held pending remote adjudication
            # rather than committed outright.
            provisional_local = aux.cover
        else:
            dest, convert = cover_destination(cfg, album_dir, aux.cover)
            plan.local_cover_src = str(aux.cover)
            plan.local_cover_convert = convert
            plan.cover_dest = str(dest)
            cover_chosen = True
            log(f"  cover: included ({aux.cover.name}{' -> jpg' if convert else ''})")

    if not cover_chosen and cfg.fetch_cover and (cfg.force_art or not has_cover_sidecar(album_dir)):
        url = resolve_cover(cfg, tracker.session, meta)
        if url and provisional_local is not None:
            # Adjudicate the provisional local cover against the remote
            # candidate. The remote supersedes only when it meets the pixel
            # gate; otherwise the local image is retained despite its size.
            data = fetch_url_bytes(tracker.session, url, cfg.request_timeout)
            dims = image_dimensions_bytes(data) if data else None
            remote_qualifies = dims is not None and min(dims) >= cfg.min_cover_px
            if data and remote_qualifies:
                plan.cover_url = url
                plan.cover_data = data
                plan.cover_dest = str(album_dir / cfg.cover_filename)
                cover_chosen = True
                # The superseded local image is diverted to unmatched files for
                # visibility, on the premise that a size-deficient local match
                # may still be preferable to the remote result.
                plan.unmatched_images.append(
                    AuxMove(str(provisional_local),
                            str(unmatched_root / provisional_local.name)))
                log(f"  cover: remote supersedes low-res local "
                    f"({provisional_local.name} -> {cfg.unmatched_images_dirname})")
            else:
                dest, convert = cover_destination(cfg, album_dir, provisional_local)
                plan.local_cover_src = str(provisional_local)
                plan.local_cover_convert = convert
                plan.cover_dest = str(dest)
                cover_chosen = True
                log(f"  cover: low-res local retained; remote absent or "
                    f"below threshold ({provisional_local.name})")
        elif url:
            plan.cover_url = url
            plan.cover_dest = str(album_dir / cfg.cover_filename)
            cover_chosen = True
            log("  cover: fetched from tracker/itunes")
        elif provisional_local is not None:
            # No remote candidate resolved; the provisional local cover stands.
            dest, convert = cover_destination(cfg, album_dir, provisional_local)
            plan.local_cover_src = str(provisional_local)
            plan.local_cover_convert = convert
            plan.cover_dest = str(dest)
            cover_chosen = True
            log(f"  cover: low-res local retained; no remote candidate "
                f"({provisional_local.name})")
        else:
            log("  cover: not found")
            plan.warnings.append("cover art could not be resolved")
    elif provisional_local is not None and not cover_chosen:
        # Remote fetch disabled or a sidecar already exists; retain the local
        # image rather than discarding it for being small.
        dest, convert = cover_destination(cfg, album_dir, provisional_local)
        plan.local_cover_src = str(provisional_local)
        plan.local_cover_convert = convert
        plan.cover_dest = str(dest)
        cover_chosen = True
        log(f"  cover: low-res local retained ({provisional_local.name})")

    for img in aux.other_images:
        plan.unmatched_images.append(AuxMove(str(img), str(scans_root / img.name)))
    for doc in aux.booklets:
        plan.booklet_files.append(AuxMove(str(doc), str(booklet_root / doc.name)))
    for extra in aux.extras:
        plan.extra_files.append(AuxMove(str(extra), str(extras_root / extra.name)))
    if aux.ambiguous_cover:
        log(f"  cover: ambiguous; {len(aux.other_images)} images -> {cfg.scans_dirname}")
    aux_counts = []
    if plan.booklet_files:
        aux_counts.append(f"{len(plan.booklet_files)} booklet")
    if plan.unmatched_images:
        aux_counts.append(f"{len(plan.unmatched_images)} image")
    if plan.extra_files:
        aux_counts.append(f"{len(plan.extra_files)} extra")
    if aux_counts:
        log("  aux: " + ", ".join(aux_counts))

    if cfg.fetch_artist_image and meta.artist_id:
        try:
            image = tracker.artist(meta.artist_id).get("image")
        except (TrackerError, requests.RequestException) as exc:
            image = None
            plan.warnings.append(f"artist lookup failed: {exc}")
        artist_dest = artist_dir / cfg.artist_filename
        if image and (cfg.force_art or not artist_dest.exists()):
            plan.artist_image_url = image
            plan.artist_image_dest = str(artist_dest)
            log("  artist image: resolved")

    log(f"  planned {len(plan.files)} file operations -> {album_dir}")
    return plan


# --------------------------------------------------------------------------- #
# Reporting
# --------------------------------------------------------------------------- #

def print_report(plans: list[AlbumPlan]) -> None:
    for plan in plans:
        print("=" * 72)
        print(f"SOURCE : {Path(plan.source_dir).name}")
        if not plan.matched:
            print("STATUS : UNMATCHED")
            for w in plan.warnings:
                print(f"  ! {w}")
            continue
        print(f"ALBUM  : {plan.album} ({plan.year})   [{plan.sample_rate or '?'}]")
        print(f"ARTIST : {plan.album_artist}")
        print(f"GENRES : {'; '.join(plan.genres) or '(none)'}")
        print(f"  raw tracker tags: {', '.join(plan.raw_tags) or '(none)'}")
        if plan.release_type_name:
            print(f"RELEASE: {plan.release_type_name}")
        if plan.albumversion:
            print(f"VERSION: {plan.albumversion}")
        print(f"DEST   : {plan.album_dir}")
        for f in plan.files:
            print(f"  {Path(f.src).name}  ->  {Path(f.dest).name}")
        if plan.local_cover_src:
            suffix = " (convert to jpg)" if plan.local_cover_convert else ""
            print(f"COVER  : included {Path(plan.local_cover_src).name}{suffix}")
        elif plan.cover_dest:
            print(f"COVER  : {plan.cover_url}")
        if plan.booklet_files:
            booklet_dir = Path(plan.booklet_files[0].dest).parent
            print(f"BOOKLET: {len(plan.booklet_files)} -> {booklet_dir}")
        for m in plan.unmatched_images:
            print(f"  image (scan) {Path(m.src).name} -> {m.dest}")
        for m in plan.extra_files:
            print(f"  extra {Path(m.src).name} -> {m.dest}")
        if plan.artist_image_dest:
            print(f"ARTIST IMG: {plan.artist_image_url}")
        for w in plan.warnings:
            print(f"  ! {w}")
    print("=" * 72)


# --------------------------------------------------------------------------- #
# Plan serialization
# --------------------------------------------------------------------------- #

def plan_to_dict(plans: list[AlbumPlan]) -> dict:
    # cover_data holds raw bytes for in-process reuse and is not JSON-encodable;
    # it is dropped on serialization and re-fetched from cover_url if needed.
    def _encode(p: AlbumPlan) -> dict:
        d = dataclasses.asdict(p)
        d.pop("cover_data", None)
        return d
    return {"albums": [_encode(p) for p in plans]}


def dict_to_plans(data: dict) -> list[AlbumPlan]:
    plans = []
    for entry in data.get("albums", []):
        files = [FileOp(**f) for f in entry.pop("files", [])]
        booklets = [AuxMove(**m) for m in entry.pop("booklet_files", [])]
        unmatched = [AuxMove(**m) for m in entry.pop("unmatched_images", [])]
        extras = [AuxMove(**m) for m in entry.pop("extra_files", [])]
        plan = AlbumPlan(**entry)
        plan.files = files
        plan.booklet_files = booklets
        plan.unmatched_images = unmatched
        plan.extra_files = extras
        plans.append(plan)
    return plans


def write_plan(plans: list[AlbumPlan], path: Path) -> None:
    path.write_text(json.dumps(plan_to_dict(plans), indent=2, ensure_ascii=False))


def load_plan(path: Path) -> list[AlbumPlan]:
    return dict_to_plans(json.loads(path.read_text()))


# --------------------------------------------------------------------------- #
# Apply
# --------------------------------------------------------------------------- #

def apply_plan(cfg: Config, plans: list[AlbumPlan], tracker: Optional[Tracker],
               dry_run: bool = False) -> None:
    session = tracker.session if tracker is not None else requests.Session()
    for plan in plans:
        if not plan.matched:
            continue
        album_dir = Path(plan.album_dir)
        if not dry_run:
            album_dir.mkdir(parents=True, exist_ok=True)
        fields = fields_for_plan(cfg, plan)
        moved_from: set[Path] = set()
        for f in plan.files:
            src, dest = Path(f.src), Path(f.dest)
            moved_from.add(src.parent)
            print(f"move {src.name} -> {dest}")
            if not dry_run:
                dest.parent.mkdir(parents=True, exist_ok=True)
                os.replace(src, dest)
                # Per-track fields override album-wide fields. The track tag
                # holds the bare per-disc track number and restarts at 1 on each
                # disc; disc identity is carried solely by the discnumber tag.
                # The concatenated <disc><track> form is a filename convention
                # and is not applied to tags.
                track_fields = {**fields, "discnumber": [str(f.disc)],
                                "tracknumber": [str(f.track)]}
                apply_tags(dest, track_fields)

        if plan.local_cover_src and plan.cover_dest:
            print(f"cover (included) -> {plan.cover_dest}")
            if not dry_run:
                src = Path(plan.local_cover_src)
                moved_from.add(src.parent)
                place_local_cover(src, Path(plan.cover_dest), plan.local_cover_convert,
                                  cfg.max_art_px)
        elif plan.cover_url and plan.cover_dest:
            print(f"cover (remote) -> {plan.cover_dest}")
            if not dry_run:
                data = plan.cover_data or fetch_url_bytes(
                    session, plan.cover_url, cfg.request_timeout)
                if data:
                    _save_image(data, Path(plan.cover_dest), cfg.max_art_px)

        for move in plan.booklet_files:
            src, dest = Path(move.src), Path(move.dest)
            moved_from.add(src.parent)
            print(f"booklet -> {dest}")
            if not dry_run:
                _move_file(src, dest)
        for move in plan.unmatched_images:
            src, dest = Path(move.src), Path(move.dest)
            moved_from.add(src.parent)
            print(f"unmatched image -> {dest}")
            if not dry_run:
                _move_file(src, dest)
        for move in plan.extra_files:
            src, dest = Path(move.src), Path(move.dest)
            moved_from.add(src.parent)
            print(f"extra -> {dest}")
            if not dry_run:
                _move_file(src, dest)

        if plan.artist_image_url and plan.artist_image_dest:
            print(f"artist image -> {plan.artist_image_dest}")
            if not dry_run:
                data = fetch_url_bytes(session, plan.artist_image_url, cfg.request_timeout)
                if data:
                    _save_image(data, Path(plan.artist_image_dest), cfg.max_art_px)

        if not dry_run:
            for d in sorted(moved_from, key=lambda p: len(p.parts), reverse=True):
                _remove_if_empty(d)
            _remove_if_empty(Path(plan.source_dir))


def _move_file(src: Path, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    os.replace(src, dest)


def place_local_cover(src: Path, dest: Path, convert: bool, max_px: int) -> None:
    """Move an included cover into place, optionally converting PNG to JPEG.

    Conversion also downscales to max_px on the longer side. When conversion is
    disabled or unavailable the file is moved unchanged.
    """
    dest.parent.mkdir(parents=True, exist_ok=True)
    if convert and Image is not None:
        try:
            with Image.open(src) as img:
                img = img.convert("RGB")
                if max(img.size) > max_px:
                    scale = max_px / max(img.size)
                    img = img.resize((round(img.width * scale), round(img.height * scale)))
                img.save(dest, format="JPEG", quality=92)
            src.unlink()
            return
        except Exception:
            pass  # fall back to a plain move on any imaging failure
    os.replace(src, dest)


def _remove_if_empty(directory: Path) -> None:
    try:
        if directory.exists() and directory.is_dir() and not any(directory.iterdir()):
            directory.rmdir()
    except OSError:
        pass


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #

def _iter_source_dirs(paths: list[str], skip_names: frozenset[str] = frozenset()) -> list[Path]:
    out = []
    for p in paths:
        path = Path(p).expanduser()
        if not path.is_dir():
            print(f"warning: not a directory: {path}", file=sys.stderr)
            continue
        # Auxiliary directories (the extras sink, dotdirs) carry no torrent
        # association and are excluded from source resolution.
        if path.name in skip_names or path.name.startswith("."):
            continue
        out.append(path)
    return out


def _plan_dirs(cfg: Config, dirs: list[str]) -> tuple[Tracker, list[AlbumPlan]]:
    # An empty argument list expands to the immediate subdirectories of the
    # current working directory, treating each as a candidate album source.
    # _iter_source_dirs subsequently filters auxiliary and hidden directories.
    if not dirs:
        dirs = sorted(str(p) for p in Path(".").iterdir() if p.is_dir())
    tracker = Tracker(cfg)
    log(tracker.verify())
    torrent_dir = Path(cfg.torrent_dir).expanduser()
    log(f"scanning torrents: {torrent_dir}")
    index = build_torrent_index(torrent_dir)
    log(f"indexed {len(index.refs)} torrents")
    source_dirs = _iter_source_dirs(dirs, frozenset({cfg.extra_files_dirname}))
    log(f"processing {len(source_dirs)} source directories")
    plans = [build_plan_for_dir(cfg, tracker, index, d) for d in source_dirs]
    matched = sum(1 for p in plans if p.matched)
    log(f"done: {matched}/{len(plans)} matched")
    return tracker, plans


def cmd_auth(cfg: Config, args) -> int:
    """Validate the configured API key without touching the library."""
    print(Tracker(cfg).verify())
    return 0


def cmd_plan(cfg: Config, args) -> int:
    _, plans = _plan_dirs(cfg, args.dirs)
    print_report(plans)
    write_plan(plans, Path(args.plan))
    print(f"\nplan written to {args.plan}")
    return 0


def cmd_apply(cfg: Config, args) -> int:
    plans = load_plan(Path(args.plan))
    tracker = None
    if any(p.cover_url or p.artist_image_url for p in plans):
        try:
            tracker = Tracker(cfg)
        except SystemExit:
            tracker = None
    apply_plan(cfg, plans, tracker, dry_run=args.dry_run)
    return 0


def cmd_run(cfg: Config, args) -> int:
    tracker, plans = _plan_dirs(cfg, args.dirs)
    print_report(plans)
    plan_path = Path(args.plan)
    write_plan(plans, plan_path)
    print(f"\nplan written to {plan_path}")
    while True:
        choice = input("[a]pply  [e]dit plan  [q]uit > ").strip().lower()
        if choice in ("a", "apply"):
            apply_plan(cfg, load_plan(plan_path), tracker, dry_run=args.dry_run)
            return 0
        if choice in ("e", "edit"):
            os.system(f'{os.environ.get("EDITOR", "nano")} "{plan_path}"')
            continue
        if choice in ("q", "quit", ""):
            print("aborted; no changes made")
            return 1


def main(argv: Optional[list[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="gaztag", description=__doc__.splitlines()[0])
    parser.add_argument("--config", default="~/.config/gaztag/config.toml")
    parser.add_argument("--plan", default="gaztag-plan.json")
    parser.add_argument("--dest", help="destination root override")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--force-art", action="store_true")
    parser.add_argument("-q", "--quiet", action="store_true",
                        help="suppress progress output")
    sub = parser.add_subparsers(dest="command", required=True)

    p_run = sub.add_parser("run", help="plan, confirm, then apply")
    p_run.add_argument("dirs", nargs="*")
    p_run.set_defaults(func=cmd_run)

    p_plan = sub.add_parser("plan", help="resolve metadata and write a plan")
    p_plan.add_argument("dirs", nargs="*")
    p_plan.set_defaults(func=cmd_plan)

    p_apply = sub.add_parser("apply", help="execute a previously written plan")
    p_apply.set_defaults(func=cmd_apply)

    p_auth = sub.add_parser("auth", help="validate the API key and print the account identity")
    p_auth.set_defaults(func=cmd_auth)

    args = parser.parse_args(argv)
    set_progress(not args.quiet)
    config_path = args.config if Path(args.config).expanduser().exists() else None
    cfg = Config.load(config_path)
    if args.dest:
        cfg.dest_root = args.dest
    if args.force_art:
        cfg.force_art = True
    return args.func(cfg, args)


if __name__ == "__main__":
    sys.exit(main())
