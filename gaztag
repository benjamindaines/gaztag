@dataclass
class Config:
    # Tracker access. base_url is the site origin, e.g. "https://tracker.example".
    base_url: str = ""
    api_token: str = ""
    # This is the directory where your torrent client (or you) store .torrent files
    # that have been added to your client. Ex. Transmission renames to .torrent.added
    # and keeps them in the watched directory for auto-add.
    torrent_dir: str = ""

    # Destination root. Empty writes in place, beside each source directory.
    dest_root: str = ""
    # Subdirectory inserted between the destination root and the album-artist
    # directory for DSD releases. Empty disables the split.
    dsd_subdir: str = "00 DSD"

    # Rate limiting for tracker ajax calls.
    requests_per_window: int = 10
    window_seconds: float = 10.0
    request_timeout: float = 30.0

    # Genre handling. genre_join collapses the mapped genres into a single tag
    # value; set to null in TOML to write each genre as a separate value.
    genre_map: dict = field(default_factory=lambda: dict(DEFAULT_GENRE_MAP))
    genre_blocklist: set = field(default_factory=lambda: set(DEFAULT_GENRE_BLOCKLIST))
    max_genres: int = 3
    genre_join: Optional[str] = "; "

    # Album artist derivation.
    va_release_types: set = field(default_factory=lambda: set(DEFAULT_VA_RELEASE_TYPES))
    various_artists_label: str = "Various Artists"
    artist_join: str = ", "

    # Naming. file_template fields: pos, title, disc, track, ext.
    #   pos is disc*100+track on multi-disc releases, else the zero-padded track.
    file_template: str = "{pos} - {title}{ext}"
    # album_dir_template fields: year, album, sort_title, album_artist, label,
    # catno, sample_rate, release_type, version.
    album_dir_template: str = "({year}) {album} [{sample_rate}]"
    # Leading articles are retained by default (empty list). Frontend sorting is
    # assumed to handle article-insensitive ordering.
    sort_articles: tuple = ()

    # Sample-rate rendering. PCM is expressed in kHz. DSD may be expressed in MHz
    # (e.g. "2.8224 MHz") or kHz (e.g. "2822.4 kHz").
    dsd_sample_rate_unit: str = "MHz"

    # Tag writing. Genre, album, album artist, and date are written from the
    # tracker. releasetype and albumversion are written only when non-empty and
    # never blank an existing value. Per-track fields are never sourced here.
    write_genre: bool = True
    write_album: bool = True
    write_albumartist: bool = True
    write_date: bool = True
    write_releasetype: bool = True
    write_albumversion: bool = True
    write_label: bool = False
    write_catalognumber: bool = False
    # A plain WEB/PCM original with no remaster receives a blank albumversion.
    albumversion_blank_plain: bool = True
    # Remove a trailing edition segment from the album title when it restates
    # the release edition already captured structurally (remaster year/title or
    # a recognized edition keyword), e.g. "Album (2011 Remaster)" -> "Album".
    strip_album_edition: bool = True

    # Artwork.
    fetch_cover: bool = True
    fetch_artist_image: bool = True
    force_art: bool = False
    cover_filename: str = "cover.jpg"
    artist_filename: str = "artist.jpg"
    max_art_px: int = 2000
    cover_sources: tuple = ("tracker", "itunes")
    # Included-artwork handling. An image at least min_cover_px on its shorter
    # side qualifies as cover art; a qualifying image named like a cover, or the
    # sole qualifying image, is selected. PNG covers are converted to JPEG when
    # Pillow is available and conversion is enabled.
    use_included_cover: bool = True
    min_cover_px: int = 1000
    cover_convert_png_to_jpg: bool = True
    # Leftover-file routing, relative to each source directory's parent (for
    # unmatched images and extras) or the renamed album directory (for booklets).
    handle_aux_files: bool = True
    # Leftover images (booklet scans, back/inlay/disc art, etc.) are filed in a
    # subdirectory of the renamed album directory rather than discarded.
    scans_dirname: str = "scans"
    unmatched_images_dirname: str = "unmatched files"
    extra_files_dirname: str = ".extraFiles"
    booklet_dirname: str = "booklet"

    @classmethod
    def load(cls, path: Optional[str]) -> "Config":
        cfg = cls()
        if path:
            data = _read_toml(Path(path).expanduser())
            for key, value in data.items():
                if not hasattr(cfg, key):
                    print(f"warning: unknown config key '{key}' ignored", file=sys.stderr)
                    continue
                current = getattr(cfg, key)
                if isinstance(current, dict) and isinstance(value, dict):
                    current.update(value)
                elif isinstance(current, set) and isinstance(value, list):
                    setattr(cfg, key, set(value))
                elif isinstance(current, tuple) and isinstance(value, list):
                    setattr(cfg, key, tuple(value))
                else:
                    setattr(cfg, key, value)
        cfg.api_token = os.environ.get("RED_API_TOKEN", cfg.api_token)
        cfg.base_url = os.environ.get("RED_BASE_URL", cfg.base_url).rstrip("/")
        return cfg


def _read_toml(path: Path) -> dict:
    if not path.exists():
        raise SystemExit(f"config file not found: {path}")
    if tomllib is None:  # pragma: no cover
        raise SystemExit("tomllib unavailable; Python 3.11+ is required for TOML config")
    with path.open("rb") as fh:
        return tomllib.load(fh)


# --------------------------------------------------------------------------- #
# Bencode / torrent parsing
# --------------------------------------------------------------------------- #

class BencodeError(ValueError):
    pass


class _BDecoder:
    def __init__(self, data: bytes):
        self.data = data
        self.pos = 0
        self.info_span: Optional[tuple[int, int]] = None

    def decode(self) -> Any:
        return self._value()

    def _value(self) -> Any:
        c = self.data[self.pos : self.pos + 1]
        if c == b"i":
            return self._int()
        if c == b"l":
            return self._list()
        if c == b"d":
            return self._dict()
        if c.isdigit():
            return self._bytes()
        raise BencodeError(f"unexpected token {c!r} at {self.pos}")

    def _int(self) -> int:
        end = self.data.index(b"e", self.pos)
        value = int(self.data[self.pos + 1 : end])
        self.pos = end + 1
        return value

    def _bytes(self) -> bytes:
        colon = self.data.index(b":", self.pos)
        length = int(self.data[self.pos : colon])
        start = colon + 1
        self.pos = start + length
        return self.data[start : self.pos]

    def _list(self) -> list:
        self.pos += 1
        out = []
        while self.data[self.pos : self.pos + 1] != b"e":
            out.append(self._value())
        self.pos += 1
        return out

    def _dict(self) -> dict:
        self.pos += 1
        out: dict = {}
        while self.data[self.pos : self.pos + 1] != b"e":
            key = self._bytes()
            value_start = self.pos
            value = self._value()
            if key == b"info":
                self.info_span = (value_start, self.pos)
            out[key] = value
        self.pos += 1
        return out


@dataclass
class TorrentRef:
    path: Path
    name: str
    infohash: str
    torrent_id: Optional[int]        # authoritative id parsed from the comment
    filename_id: Optional[int] = None  # id from the filename; may be truncated
    audio_sizes: tuple = ()          # sorted sizes of audio payload files
    audio_names: tuple = ()          # basenames of audio payload files


def _torrent_filename_stem(path: Path) -> str:
    """Return the torrent filename without its .torrent(.added) suffix."""
    name = path.name
    for suffix in (".torrent.added", ".torrent"):
        if name.lower().endswith(suffix):
            return name[: -len(suffix)]
    return name


def normalize_release_name(name: str) -> str:
    """Reduce a release name to a match key.

    A trailing tracker id of the form "-<digits>" (four or more digits, as
    appended to downloaded torrent filenames such as "... (WEB - FLAC -
    Lossless)-6353858") is removed. Underscores are converted to spaces to undo
    the space substitution the tracker applies to torrent filenames, and
    internal whitespace is collapsed. Album names ending in short volume markers
    such as "-1" are left intact.
    """
    name = unicodedata.normalize("NFC", name).strip()
    name = re.sub(r"-\d{4,}$", "", name)
    name = name.replace("_", " ")
    name = re.sub(r"\s+", " ", name).strip()
    return name


def _torrent_audio_files(info: dict) -> list[tuple[str, int]]:
    """Return (basename, size) for each audio file in a parsed info dictionary.

    Both single-file and multi-file torrents are handled. Non-audio payload such
    as cover art and logs is excluded so the signature depends only on the audio
    content.
    """
    out: list[tuple[str, int]] = []
    files = info.get(b"files")
    if files:
        for entry in files:
            path_parts = entry.get(b"path.utf-8") or entry.get(b"path") or []
            if not path_parts:
                continue
            basename = path_parts[-1].decode("utf-8", "replace")
            if Path(basename).suffix.lower() in AUDIO_EXTENSIONS:
                out.append((basename, int(entry.get(b"length", 0))))
    else:
        name_b = info.get(b"name.utf-8") or info.get(b"name") or b""
        basename = name_b.decode("utf-8", "replace")
        if Path(basename).suffix.lower() in AUDIO_EXTENSIONS:
            out.append((basename, int(info.get(b"length", 0))))
    return out


def parse_torrent(path: Path) -> Optional[TorrentRef]:
    try:
        raw = path.read_bytes()
        decoder = _BDecoder(raw)
        meta = decoder.decode()
    except (OSError, BencodeError, ValueError):
        return None
    if decoder.info_span is None:
        return None
    info_bytes = raw[decoder.info_span[0] : decoder.info_span[1]]
    infohash = hashlib.sha1(info_bytes).hexdigest().upper()
    info = meta.get(b"info", {})
    name_b = info.get(b"name.utf-8") or info.get(b"name")
    if not name_b:
        return None
    name = name_b.decode("utf-8", "replace")
    torrent_id = None
    comment = meta.get(b"comment")
    if comment:
        m = TORRENTID_RE.search(comment.decode("utf-8", "replace"))
        if m:
            torrent_id = int(m.group(1))
    filename_id = None
    fm = re.search(r"-(\d{4,})$", _torrent_filename_stem(path))
    if fm:
        filename_id = int(fm.group(1))
    audio = _torrent_audio_files(info)
    audio_sizes = tuple(sorted(size for _, size in audio))
    audio_names = tuple(basename for basename, _ in audio)
    return TorrentRef(path=path, name=name, infohash=infohash, torrent_id=torrent_id,
                      filename_id=filename_id, audio_sizes=audio_sizes,
                      audio_names=audio_names)


def _dir_audio_sizes(source_dir: Path) -> tuple:
    sizes = []
    for p in source_dir.rglob("./*"):
        if p.is_file() and p.suffix.lower() in AUDIO_EXTENSIONS:
            try:
                sizes.append(p.stat().st_size)
            except OSError:
                continue
    return tuple(sorted(sizes))


@dataclass
class MatchResult:
    ref: Optional[TorrentRef]
    method: str = ""
    suggestion: str = ""


class TorrentIndex:

    def __init__(self) -> None:
        self.refs: list[TorrentRef] = []
        self._by_name: dict[str, TorrentRef] = {}
        self._by_norm: dict[str, TorrentRef] = {}
        self._by_fnorm: dict[str, TorrentRef] = {}
        self._by_sizes: dict[tuple, TorrentRef] = {}

    def add(self, ref: TorrentRef) -> None:
        self.refs.append(ref)
        self._by_name.setdefault(ref.name, ref)
        self._by_norm.setdefault(normalize_release_name(ref.name), ref)
        self._by_fnorm.setdefault(normalize_release_name(_torrent_filename_stem(ref.path)), ref)
        if ref.audio_sizes:
            self._by_sizes.setdefault(ref.audio_sizes, ref)

    def match(self, source_dir: Path) -> MatchResult:
        dir_name = source_dir.name
        if dir_name in self._by_name:
            return MatchResult(self._by_name[dir_name], "exact name")
        norm = normalize_release_name(dir_name)
        if norm in self._by_norm:
            return MatchResult(self._by_norm[norm], "normalized name")
        if norm in self._by_fnorm:
            return MatchResult(self._by_fnorm[norm], "torrent filename")

        dir_sizes = _dir_audio_sizes(source_dir)
        if dir_sizes:
            if dir_sizes in self._by_sizes:
                return MatchResult(self._by_sizes[dir_sizes], "content signature")
            dir_set = set(dir_sizes)
            for ref in self.refs:
                if ref.audio_sizes and set(ref.audio_sizes).issubset(dir_set):
                    return MatchResult(ref, "content subset")

        matches = difflib.get_close_matches(norm, list(self._by_norm.keys()), n=1, cutoff=0.8)
        return MatchResult(None, "", matches[0] if matches else "")


def build_torrent_index(torrent_dir: Path) -> TorrentIndex:
    index = TorrentIndex()
    if not torrent_dir.exists():
        return index
    for path in sorted(torrent_dir.rglob("*")):
        if not path.is_file():
            continue
        lower = path.name.lower()
        if not (lower.endswith(".torrent") or lower.endswith(".torrent.added")):
            continue
        ref = parse_torrent(path)
        if ref is not None:
            index.add(ref)
    return index


