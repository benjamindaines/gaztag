ILLEGAL_FS = re.compile(r'[<>:"/\\|?*\x00-\x1f]')


def sanitize(name: str) -> str:
    name = unicodedata.normalize("NFC", name)
    name = ILLEGAL_FS.sub("", name)
    name = re.sub(r"\s+", " ", name).strip().rstrip(". ")
    return name or "Untitled"


def sort_title(cfg: Config, album: str) -> str:
    words = album.split()
    if words and cfg.sort_articles and words[0].lower() in cfg.sort_articles:
        words = words[1:]
    return " ".join(words) or album


def position_string(disc: int, track: int, multidisc: bool) -> str:
    if multidisc:
        return f"{disc}{track:02d}"
    return f"{track:02d}"


def _clean_dir_name(name: str) -> str:
    # Empty template fields leave stray bracket pairs and double spaces.
    name = re.sub(r"\[\s*\]", "", name)
    name = re.sub(r"\(\s*\)", "", name)
    return sanitize(name)


