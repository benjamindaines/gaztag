@dataclass
class TrackInfo:
    src: Path
    disc: int
    track: int
    title: str
    sample_rate: int
    is_dsd: bool


def _first(value) -> str:
    if isinstance(value, list):
        return str(value[0]) if value else ""
    return str(value) if value is not None else ""


def read_track_info(path: Path, disc_hint: Optional[int]) -> TrackInfo:
    disc = disc_hint or 1
    track = 0
    title = path.stem
    sample_rate = 0
    is_dsd = path.suffix.lower() in DSD_EXTENSIONS
    if mutagen is not None:
        try:
            audio = mutagen.File(str(path), easy=True)
        except Exception:
            audio = None
        if audio is not None:
            tags = audio.tags or {}
            title = _first(tags.get("title")) or title
            tn = _first(tags.get("tracknumber"))
            if tn:
                track = int(re.split(r"[/\s]", tn)[0] or 0)
            dns = _first(tags.get("discnumber"))
            if dns and disc_hint is None:
                disc = int(re.split(r"[/\s]", dns)[0] or 1)
            info = getattr(audio, "info", None)
            sample_rate = int(getattr(info, "sample_rate", 0) or 0)
    if track == 0:
        raw = LEADING_NUM_RE.match(path.stem)
        if raw:
            n = int(raw.group(1))
            if n >= 100 and disc_hint is None:
                disc, track = divmod(n, 100)
            else:
                track = n % 100 if n >= 100 else n
    return TrackInfo(src=path, disc=disc, track=track, title=title,
                     sample_rate=sample_rate, is_dsd=is_dsd)


def collect_tracks(source_dir: Path) -> list[TrackInfo]:
    """Enumerate audio files, flattening disc subdirectories with disc numbering."""
    tracks: list[TrackInfo] = []
    for p in sorted(source_dir.iterdir()):
        if p.is_file() and p.suffix.lower() in AUDIO_EXTENSIONS:
            tracks.append(read_track_info(p, disc_hint=None))

    disc_dirs = []
    for child in sorted(source_dir.iterdir()):
        if child.is_dir():
            m = DISC_DIR_RE.match(child.name)
            if m:
                disc_dirs.append((int(m.group(1)), child))
    for disc_num, child in disc_dirs:
        for p in sorted(child.iterdir()):
            if p.is_file() and p.suffix.lower() in AUDIO_EXTENSIONS:
                tracks.append(read_track_info(p, disc_hint=disc_num))

    multidisc = len({t.disc for t in tracks}) > 1 or bool(disc_dirs)
    if not multidisc:
        for t in tracks:
            t.disc = 1
    return tracks


def format_sample_rate(hz: int, is_dsd: bool, dsd_unit: str) -> str:
    if hz <= 0:
        return ""
    if is_dsd and dsd_unit.upper() == "MHZ":
        s = f"{hz / 1_000_000:.4f}".rstrip("0").rstrip(".")
        return f"{s} MHz"
    s = f"{hz / 1000:.1f}".rstrip("0").rstrip(".")
    return f"{s} kHz"


