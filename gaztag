@dataclass
class AlbumMeta:
    album: str
    year: int
    album_artist: str
    artist_id: Optional[int]
    label: str
    catalog: str
    release_type: int
    release_type_name: str
    genres: list[str]
    media: str
    remastered: bool
    remaster_year: int
    remaster_title: str
    remaster_label: str
    wiki_image: Optional[str]
    raw_tags: list[str]


def _derive_album_artist(cfg: Config, music_info: dict, release_type: int) -> tuple[str, Optional[int]]:
    artists = music_info.get("artists") or []
    if release_type in cfg.va_release_types and len(artists) != 1:
        return cfg.various_artists_label, None
    if not artists:
        return cfg.various_artists_label, None
    if len(artists) == 1:
        a = artists[0]
        return a["name"], a.get("id")
    names = cfg.artist_join.join(a["name"] for a in artists)
    return names, artists[0].get("id")


def map_genres(cfg: Config, raw_tags: list[str]) -> list[str]:
    out: list[str] = []
    for tag in raw_tags:
        key = tag.strip().lower()
        if not key or key in cfg.genre_blocklist:
            continue
        mapped = cfg.genre_map.get(key)
        if mapped is None:
            mapped = " ".join(part.capitalize() for part in re.split(r"[.\s_]+", key))
        if mapped not in out:
            out.append(mapped)
        if len(out) >= cfg.max_genres:
            break
    return out


def _select_torrent(response: dict) -> dict:
    if "torrent" in response:
        return response["torrent"]
    torrents = response.get("torrents") or [{}]
    return torrents[0]


def build_album_meta(cfg: Config, response: dict) -> AlbumMeta:
    group = response["group"]
    torrent = _select_torrent(response)
    music_info = group.get("musicInfo", {})
    release_type = int(group.get("releaseType", 0) or 0)
    album_artist, artist_id = _derive_album_artist(cfg, music_info, release_type)
    raw_tags = group.get("tags") or []
    rt_name = "" if release_type in RELEASE_TYPE_BLANK else RELEASE_TYPE_NAMES.get(release_type, "")
    return AlbumMeta(
        album=(group.get("name") or "").strip(),
        year=int(group.get("year") or 0),
        album_artist=album_artist.strip(),
        artist_id=artist_id,
        label=(group.get("recordLabel") or "").strip(),
        catalog=(group.get("catalogueNumber") or "").strip(),
        release_type=release_type,
        release_type_name=rt_name,
        genres=map_genres(cfg, raw_tags),
        media=(torrent.get("media") or "").strip(),
        remastered=bool(torrent.get("remastered")),
        remaster_year=int(torrent.get("remasterYear") or 0),
        remaster_title=(torrent.get("remasterTitle") or "").strip(),
        remaster_label=(torrent.get("remasterRecordLabel") or "").strip(),
        wiki_image=group.get("wikiImage") or None,
        raw_tags=list(raw_tags),
    )


def build_albumversion(cfg: Config, meta: AlbumMeta, is_dsd: bool) -> str:
    """Assemble the edition/version string, e.g. 'SACD DSD (2010 Analog Productions)'."""
    family = "DSD" if is_dsd else "PCM"
    if (cfg.albumversion_blank_plain and not is_dsd
            and meta.media in ("", "WEB") and not meta.remastered):
        return ""
    base = " ".join(x for x in (meta.media, family) if x).strip()
    inner_parts = []
    if meta.remastered:
        if meta.remaster_year:
            inner_parts.append(str(meta.remaster_year))
        if meta.remaster_label:
            inner_parts.append(meta.remaster_label)
        if meta.remaster_title:
            inner_parts.append(meta.remaster_title)
    inner = " ".join(inner_parts).strip()
    return (base + (f" ({inner})" if inner else "")).strip()


# Edition keywords that mark a trailing title segment as a restatement of the
# release edition rather than part of the canonical album name.
_EDITION_KEYWORDS = (
    "remaster", "remastered", "reissue", "re-issue", "deluxe", "expanded",
    "anniversary", "SHM", "MFSL", "UACD", "edition", "version", "remix", "remixed", "mono", "stereo",
    "special edition", "collector", "bonus track", "bonus tracks",
)
# A trailing parenthesized or bracketed segment at the end of a title.
_TRAILING_SEGMENT = re.compile(r"\s*[\(\[]([^\(\)\[\]]*)[\)\]]\s*$")


def strip_album_edition(cfg: Config, meta: AlbumMeta) -> str:
    """Return the album title with a redundant trailing edition segment removed.

    A trailing "(...)" or "[...]" segment is removed when its contents restate
    the release edition: the remaster year or remaster title appears within it,
    or it contains a recognized edition keyword. Segments that form part of the
    canonical title (e.g. "Album (Original Motion Picture Soundtrack)") are not
    matched by the keyword set and are preserved. Only the final segment is
    considered, and removal runs at most once.
    """
    title = meta.album
    if not cfg.strip_album_edition or not title:
        return title
    match = _TRAILING_SEGMENT.search(title)
    if not match:
        return title
    segment = match.group(1).strip()
    seg_lower = segment.lower()
    redundant = False
    if meta.remaster_year and str(meta.remaster_year) in segment:
        redundant = True
    if meta.remaster_title and meta.remaster_title.lower() in seg_lower:
        redundant = True
    if any(kw in seg_lower for kw in _EDITION_KEYWORDS):
        redundant = True
    if not redundant:
        return title
    stripped = title[: match.start()].strip()
    # A title consisting solely of an edition segment is left intact; there is
    # no canonical name to fall back to.
    if not stripped:
        return title
    return stripped


def resolve_album(tracker: Tracker, ref: TorrentRef) -> dict:
    # The comment id is authoritative. The infohash is used when it is absent;
    # the filename id is not used for resolution because it may be truncated.
    if ref.torrent_id is not None:
        return tracker.torrent_by_id(ref.torrent_id)
    return tracker.torrent_by_hash(ref.infohash)


