# Tracker API client
# --------------------------------------------------------------------------- #

class RateLimiter:
    """Sliding-window limiter permitting a fixed count of events per interval."""

    def __init__(self, limit: int, window: float):
        self.limit = limit
        self.window = window
        self.events: deque[float] = deque()

    def acquire(self) -> None:
        now = time.monotonic()
        while self.events and now - self.events[0] >= self.window:
            self.events.popleft()
        if len(self.events) >= self.limit:
            sleep_for = self.window - (now - self.events[0]) + 0.01
            if sleep_for > 0:
                time.sleep(sleep_for)
            return self.acquire()
        self.events.append(time.monotonic())


class TrackerError(RuntimeError):
    """Tracker unavailable. Hopefully it didn't get what.c'd 🤭"""
    pass


class AuthError(TrackerError):
    """Tracker rejected auth token."""


def normalize_token(token: str) -> str:
    token = (token or "").strip()
    m = re.match(r"(?i)^(?:bearer|token)\s+(.*)$", token)
    if m:
        token = m.group(1).strip()
    return token


class Tracker:
    def __init__(self, cfg: Config):
        token = normalize_token(cfg.api_token)
        base_url = (cfg.base_url or "").strip().rstrip("/")
        if not base_url or not token:
            raise SystemExit(
                "tracker base_url and api_token must be set. Generate an API key "
                "in the tracker user settings and provide it via the RED_API_TOKEN "
                "environment variable or the config file."
            )
        self.base_url = base_url
        self.timeout = cfg.request_timeout
        self.limiter = RateLimiter(cfg.requests_per_window, cfg.window_seconds)
        self.session = requests.Session()
        # Authentication is a single header carrying the bare API key, sent with
        # every request. This key-only scheme avoids the login/cookie flow and
        # works for accounts with two-factor authentication enabled.
        self.session.headers.update({
            "Authorization": token,
            "User-Agent": "gaztag/0.2",
        })
        self._artist_cache: dict[int, dict] = {}
        self._identity: Optional[dict] = None

    def _ajax(self, action: str, **params) -> dict:
        self.limiter.acquire()
        url = f"{self.base_url}/ajax.php"
        params = {"action": action, **{k: v for k, v in params.items() if v is not None}}
        resp = self.session.get(url, params=params, timeout=self.timeout)
        if resp.status_code in (401, 403):
            raise AuthError(f"{action}: authentication rejected (HTTP {resp.status_code})")
        resp.raise_for_status()
        try:
            payload = resp.json()
        except ValueError:
            raise TrackerError(f"{action}: non-JSON response (HTTP {resp.status_code})")
        if payload.get("status") != "success":
            error = payload.get("error", "request failed")
            if isinstance(error, str) and "auth" in error.lower():
                raise AuthError(f"{action}: {error}")
            raise TrackerError(f"{action}: {error}")
        return payload["response"]

    def whoami(self) -> dict:
        if self._identity is None:
            self._identity = self._ajax("index")
        return self._identity

    def verify(self) -> str:
        try:
            ident = self.whoami()
        except AuthError as exc:
            raise SystemExit(
                f"tracker authentication failed: {exc}\n"
                "Verify the API key (tracker user settings) and, if set, the "
                "RED_API_TOKEN environment variable."
            )
        except (TrackerError, requests.RequestException) as exc:
            raise SystemExit(f"tracker unreachable during authentication: {exc}")
        username = ident.get("username", "?")
        api_version = ident.get("api_version", "?")
        return f"authenticated as {username} (api {api_version})"

    def torrent_by_hash(self, infohash: str) -> dict:
        return self._ajax("torrent", hash=infohash.upper())

    def torrent_by_id(self, torrent_id: int) -> dict:
        return self._ajax("torrent", id=torrent_id)

    def artist(self, artist_id: int) -> dict:
        if artist_id not in self._artist_cache:
            self._artist_cache[artist_id] = self._ajax("artist", id=artist_id)
        return self._artist_cache[artist_id]


